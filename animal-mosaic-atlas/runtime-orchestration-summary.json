    "designDecisionSummary": "Dark Nimbus Core canvas at 1440. One brand hue only (--bg-brand / --brand-green scale). All three patchwork animals are drawn as inline SVG polygon mosaics built exclusively from brand-green steps, neutral surfaces and text tokens; seams use --bg-base-default. Components are limited to atoms, buttons, cards, tag, page-header and stat-card; no custom component CSS, only Tailwind utilities plus Library CSS variables.",
    "componentIndexSummary": [
      "atoms: shared layout/typesetting utilities (.row, .col, .grid-*, .stack-*, .mono, .ds-hero-title, .ds-section-title)",
      "buttons: .ds-btn variants including brand and ghost",
      "cards: .ds-card surface container",
      "tag: .ds-tag pills",
      "page-header: title + description block",
      "stat-card: compact metric block"
    ],
    "uiKitSummary": "ui_kits/dev-explorer/index.html used for structural reference only (titlebar + rail + sidebar + content rhythm). Its 1184px shell must not be copied.",
    "allowedComponents": [
      "atoms",
      "buttons",
      "cards",
      "tag",
      "page-header",
      "stat-card"
    ],
