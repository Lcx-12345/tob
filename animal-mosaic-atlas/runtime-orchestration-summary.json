    "visualNorthStar": "A dark gallery wall where three animals are rebuilt from flat green patches. Each page reads like a museum label: large patchwork specimen on the left, a short identification card on the right.",
    "visualQualityCheckpoints": [
      {
        "dimension": "visual-anchor",
        "decision": "The patchwork animal SVG is the single focal object on every page, framed by a bordered specimen panel on --bg-base-secondary."
      },
      {
        "dimension": "information-hierarchy",
        "decision": "Animal name first, Latin name second, one-line trait summary third, identification keys and patch legend last."
      },
      {
        "dimension": "composition-structure",
        "decision": "Desktop split: 55% specimen panel / 45% label column, 1px token border between them, 32px gutters; single column stack below 900px."
      },
      {
        "dimension": "implementation-strategy",
        "decision": "Inline SVG polygons with Library color variables and --bg-base-default seam strokes; no bitmap assets, no custom CSS classes, no canvas-wide shadows."
      }
    ],
